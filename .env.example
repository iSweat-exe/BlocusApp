# Public (safe for the browser): Supabase project URL and publishable key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only: NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the site (used by robots.txt and sitemap.xml), e.g. https://blocus.app
NEXT_PUBLIC_SITE_URL=

# Local Supabase only (supabase/config.toml): Discord OAuth app credentials. Never commit real values.
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=
